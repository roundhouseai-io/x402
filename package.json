{
  "name": "@roundhouse/x402",
  "version": "0.0.0",
  "description": "One command for the whole x402 payment loop. Request, 402, sign via OWS, retry, receipt — with spend limits and a local ledger.",
  "keywords": [
    "x402",
    "http-402",
    "agent",
    "payments",
    "usdc",
    "base",
    "eip-3009",
    "ows",
    "mcp",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "Roundhouse AI Ltd",
  "homepage": "https://github.com/roundhouseai-io/x402#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roundhouseai-io/x402.git"
  },
  "bugs": {
    "url": "https://github.com/roundhouseai-io/x402/issues"
  },
  "type": "module",
  "bin": {
    "x402": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.9",
    "@types/node": "^26.2.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "optionalDependencies": {},
  "peerDependencies": {
    "ethers": "^6.13.0"
  },
  "peerDependenciesMeta": {
    "ethers": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  }
}
